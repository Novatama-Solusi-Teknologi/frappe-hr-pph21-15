      "delete": 1,
      "report": 1,
      "export": 1,
      "print": 1,
      "email": 0,
      "submit": 1,
      "cancel": 0,
      "amend": 0
    },
    {
      "role": "HR Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "report": 1,
      "export": 1,
      "print": 1,
      "email": 0,
      "submit": 1,
      "cancel": 0,
      "amend": 0
    }
  ],
  "sort_field": "modified",
  "sort_order": "DESC",
  "actions": [],
  "links": [],
  "is_submittable": 1,
  "autoname": "format:PPH21-BULK-{YYYY}-{#####}",
  "track_changes": 1
