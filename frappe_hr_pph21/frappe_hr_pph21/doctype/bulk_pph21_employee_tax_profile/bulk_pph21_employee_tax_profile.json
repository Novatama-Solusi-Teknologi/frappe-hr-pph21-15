{
  "doctype": "DocType",
  "name": "Bulk PPh21 Employee Tax Profile",
  "module": "Frappe HR PPh21",
  "engine": "InnoDB",
  "field_order": [
    "default_fiscal_year",
    "default_tax_year",
    "defaults_column",
    "default_method",
    "summary_column",
    "employee_count",
    "employees_section",
    "employees",
    "confirmation_section",
    "confirm_standard_assumptions"
  ],
  "fields": [
    {
      "fieldname": "default_fiscal_year",
      "fieldtype": "Link",
      "label": "Fiscal Year Default",
      "reqd": 1,
      "options": "Fiscal Year"
    },
    {
      "fieldname": "default_tax_year",
      "fieldtype": "Int",
      "label": "Tahun Pajak Default",
      "reqd": 0,
      "read_only": 1,
      "hidden": 1
    },
    {
      "fieldname": "defaults_column",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "default_method",
      "fieldtype": "Select",
      "label": "Metode Default",
      "options": "Gross Up\nGross",
      "default": "Gross Up",
      "reqd": 1
    },
    {
      "fieldname": "summary_column",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "employee_count",
      "fieldtype": "Int",
      "label": "Jumlah Profil",
      "read_only": 1
    },
    {
      "fieldname": "employees_section",
      "fieldtype": "Section Break",
      "label": "Daftar Karyawan"
    },
    {
      "fieldname": "employees",
      "fieldtype": "Table",
      "label": "Profil Karyawan",
      "options": "Bulk PPh21 Employee Tax Profile Row",
      "reqd": 1,
      "description": "Maksimum 200 baris. Company mengikuti Employee. Save hanya menyimpan draft; Submit membuat/memperbarui profil."
    },
    {
      "fieldname": "confirmation_section",
      "fieldtype": "Section Break",
      "label": "Konfirmasi Sebelum Submit"
    },
    {
      "fieldname": "confirm_standard_assumptions",
      "fieldtype": "Check",
      "label": "Saya mengonfirmasi seluruh baris memenuhi persyaratan standar",
      "default": "0",
      "no_copy": 1,
      "description": "Pegawai tetap untuk PPh21, WP dalam negeri sepanjang tahun, fasilitas Normal. NIK/NPWP opsional. Saldo awal profil baru nol; profil lama mempertahankan saldo awal dan identitas jika kolom bulk dikosongkan."
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
