{
  "doctype": "DocType",
  "name": "PPh21 Settings",
  "module": "Frappe HR PPh21",
  "engine": "InnoDB",
  "field_order": [
    "settings_name",
    "company",
    "enabled",
    "settings_column",
    "rounding",
    "rule_version",
    "accounts_section",
    "expense_account",
    "accounts_column",
    "tax_payable_account",
    "components_section",
    "allowance_component",
    "components_column",
    "withholding_component",
    "components_column_2",
    "refund_component",
    "mapping_section",
    "component_mapping",
    "notes"
  ],
  "fields": [
    {
      "fieldname": "settings_name",
      "label": "Nama Pengaturan",
      "fieldtype": "Data",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "company",
      "label": "Company",
      "fieldtype": "Link",
      "options": "Company",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "enabled",
      "label": "Aktifkan PPh21",
      "fieldtype": "Check",
      "default": "0",
      "description": "Hanya pegawai dengan PPh21 Enabled yang diproses."
    },
    {
      "fieldname": "settings_column",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "rounding",
      "label": "Pembulatan PPh",
      "fieldtype": "Select",
      "options": "Floor IDR\nHalf Up IDR",
      "default": "Floor IDR",
      "reqd": 1,
      "description": "Konfirmasikan dengan hasil pelaporan pajak. PKP tahunan selalu dibulatkan ke bawah ke ribuan rupiah."
    },
    {
      "fieldname": "rule_version",
      "label": "Versi Master Pajak",
      "fieldtype": "Data",
      "read_only": 1,
      "default": "PP58-2023_PMK168-2023_v1"
    },
    {
      "fieldname": "accounts_section",
      "fieldtype": "Section Break",
      "label": "Akun Perusahaan"
    },
    {
      "fieldname": "expense_account",
      "label": "Beban Tunjangan PPh 21",
      "fieldtype": "Link",
      "options": "Account",
      "reqd": 1
    },
    {
      "fieldname": "accounts_column",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "tax_payable_account",
      "label": "Utang PPh 21 / Pengembalian",
      "fieldtype": "Link",
      "options": "Account",
      "reqd": 1
    },
    {
      "fieldname": "mapping_section",
      "fieldtype": "Section Break",
      "label": "Pemetaan Komponen"
    },
    {
      "fieldname": "component_mapping",
      "label": "Pemetaan Komponen",
      "fieldtype": "Table",
      "options": "PPh21 Component Tax Mapping",
      "reqd": 1
    },
    {
      "fieldname": "notes",
      "label": "Catatan",
      "fieldtype": "Small Text"
    },
    {
      "fieldname": "allowance_component",
      "label": "Komponen Tunjangan PPh21",
      "fieldtype": "Link",
      "options": "Salary Component",
      "read_only": 1,
      "no_copy": 1
    },
    {
      "fieldname": "withholding_component",
      "label": "Komponen Potongan PPh21",
      "fieldtype": "Link",
      "options": "Salary Component",
      "read_only": 1,
      "no_copy": 1
    },
    {
      "fieldname": "refund_component",
      "label": "Komponen Pengembalian PPh21",
      "fieldtype": "Link",
      "options": "Salary Component",
      "read_only": 1,
      "no_copy": 1
    },
    {
      "fieldname": "components_section",
      "fieldtype": "Section Break",
      "label": "Komponen Otomatis",
      "collapsible": 1
    },
    {
      "fieldname": "components_column",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "components_column_2",
      "fieldtype": "Column Break"
    }
  ],
  "track_changes": 1,
  "sort_field": "modified",
  "sort_order": "DESC",
  "actions": [],
  "links": [],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "report": 1,
      "export": 1,
      "print": 1,
      "email": 0
    },
    {
      "role": "HR Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "report": 1,
      "export": 1,
      "print": 1,
      "email": 0
    }
  ],
  "autoname": "format:PPH21-SET-{#####}",
  "allow_rename": 0,
  "title_field": "settings_name",
  "show_title_field_in_link": 1,
  "search_fields": "settings_name,company"
}
